;; The native open-world render pipelines as data, single-sourced with the
;; Rust `PIPELINE_SPECS` const in `kami-render/src/pipeline_specs.rs`
;; (itself GENERATED by `bb gen-pipeline-specs` from kami.pipelines/native-pipelines).
;; Ported verbatim as data — this table has no wgpu dependency, it's the
;; per-scene-pipeline cull/depth/blend policy.
[{:name "atlas" :shader "scene_atlas" :cull :none :depth-write false :depth-compare "less" :blend :alpha}
 {:name "character" :shader "scene_character" :cull :back :depth-write true :depth-compare "less" :blend :none}
 {:name "particle" :shader "scene_particle" :cull :none :depth-write false :depth-compare "less" :blend :alpha}
 {:name "sky" :shader "scene_sky" :cull :none :depth-write false :depth-compare "less-equal" :blend :none}
 {:name "terrain" :shader "scene_terrain" :cull :back :depth-write true :depth-compare "less" :blend :none}
 {:name "vegetation" :shader "scene_vegetation" :cull :none :depth-write true :depth-compare "less" :blend :alpha}
 {:name "voxel" :shader "scene_voxel" :cull :back :depth-write true :depth-compare "less" :blend :none}
 {:name "water" :shader "scene_water" :cull :none :depth-write false :depth-compare "less" :blend :alpha}]
