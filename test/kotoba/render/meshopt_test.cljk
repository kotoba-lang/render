(ns kotoba.render.meshopt-test
  "Parity tests ported from `kami-render/src/meshopt.rs`'s `#[cfg(test)]
   mod tests` — the byte vectors are the exact fixtures the Rust source
   says were 'produced by the real meshoptimizer C++ encoder
   (zeux/meshoptimizer, encode version 1)', proving this port is bit-exact."
  (:require [clojure.test :refer [deftest is]]
            [kotoba.render.meshopt :as mo]))

(deftest vertex-buffer-matches-reference-encoder
  (let [venc [0xa1 0xff 0xff 0xff 0xff 0x00 0x98 0x98 0x98 0xd8 0x58 0x00 0xa8 0xa8
              0xa8 0x68 0xe8 0x00 0x98 0xb8 0x98 0x78 0xd8 0x00 0x98 0x98 0x98 0x98
              0xd8 0x00 0xa8 0xa8 0xa8 0xa8 0x68 0x00 0x98 0xb8 0x98 0xb8 0x58 0x00
              0xa8 0x88 0xa8 0xc8 0x68 0x00 0xa8 0xa8 0xa8 0x68 0xe8 0x00 0x98 0xb8
              0x98 0x78 0xd8 0x00 0xa8 0x88 0xa8 0x88 0xe8 0x00 0x98 0x98 0x98 0x98
              0xd8 0x00 0x98 0xb8 0x98 0xb8 0x58 0x00 0xa8 0x88 0xa8 0xc8 0x68 0x00
              0x98 0x98 0x98 0xd8 0x58 0x00 0xa8 0xa8 0xa8 0x68 0xe8 0x00 0xa8 0x88
              0xa8 0x88 0xe8 0x00 0x00 0x00 0x00 0x0d 0x32 0x57 0x7c 0xa0 0xc7 0xea
              0x11 0x37 0x58 0x7d 0xa6 0xca 0xed 0x10 0x3b 0x00 0x00 0x00 0x00]
        vexp [0x0d 0x32 0x57 0x7c 0xa0 0xc7 0xea 0x11 0x37 0x58 0x7d 0xa6 0xca 0xed
              0x10 0x3b 0x59 0x86 0xa3 0xc8 0xf4 0x13 0x3e 0x65 0x83 0xac 0xc9 0xf2
              0x1e 0x39 0x64 0x8f 0xa5 0xda 0xff 0x14 0x48 0x6f 0x82 0xb9 0xdf 0xf0
              0x15 0x4e 0x62 0x85 0xb8 0xd3 0xf1 0x2e 0x4b 0x60 0x9c 0xbb 0xd6 0x0d
              0x2b 0x44 0x61 0x9a 0xb6 0xd1 0x0c 0x27 0x5d 0x62 0x87 0xac 0xf0 0x17
              0x3a 0x41 0x67 0x88 0xad 0xf6 0x1a 0x3d 0x40 0x6b 0x89 0xd6 0xf3 0x18
              0x24 0x43 0x6e 0xb5 0xd3 0xfc 0x19 0x22 0x4e 0x69 0xb4 0xdf]
        out (mo/decode-vertex-buffer 6 16 venc)]
    (is (= out vexp))))

(deftest index-triangles-match-reference-encoder
  (let [ienc [0xe1 0xf0 0x10 0xfe 0xff 0x1e 0xa6 0xf0 0x0c 0xff 0x02 0x02 0x02 0x00
              0x76 0x87 0x56 0x67 0x78 0xa9 0x86 0x65 0x89 0x68 0x98 0x01 0x69 0x00
              0x00]
        iexp [0 1 2 2 1 3 4 6 5 7 8 9 9 8 10 0 2 4]
        out (mo/decode-index-buffer (count iexp) 4 ienc)]
    (is (= out iexp))))

(deftest index-sequence-matches-reference-encoder
  (let [senc [0xd1 0x0c 0x06 0x0c 0x0a 0x10 0x10 0x1a 0x10 0x02 0x06 0x08 0x00 0x00
              0x00 0x00]
        sexp [3 1 4 1 5 9 2 6 5 3 5]
        out (mo/decode-index-sequence (count sexp) 4 senc)]
    (is (= out sexp))))

(deftest filter-oct-matches-reference
  (let [buf [0x00 0x00 0x7f 0x7f 0x00 0x7f 0x7f 0x81 0x2a 0x2a 0x7f 0x7f 0xdb 0x25
             0x7f 0x7f]
        exp [0x00 0x00 0x7f 0x7f 0x00 0x7f 0x00 0x81 0x49 0x49 0x4a 0x7f 0xc1 0x3f
             0x5a 0x7f]
        out (mo/decode-filter-oct buf 4 4)]
    (is (= out exp))))

(deftest filter-quat-matches-reference
  (let [buf [0x00 0x00 0x00 0x00 0x00 0x00 0xff 0x07 0x00 0x00 0x00 0x00 0xff 0x07
             0xfc 0x07 0xa7 0x05 0xa7 0x05 0xa7 0x05 0xfc 0x07]
        exp [0x00 0x00 0x00 0x00 0x00 0x00 0xff 0x7f 0x82 0x5a 0x00 0x00 0x00 0x00
             0x82 0x5a 0x0f 0x40 0xfa 0x3f 0xfa 0x3f 0xfa 0x3f]
        out (mo/decode-filter-quat buf 3 8)]
    (is (= out exp))))

(deftest filter-exp-matches-reference
  (let [buf [0x00 0x20 0x00 0xf3 0x00 0x38 0x00 0xf4 0x00 0xdc 0xff 0xf4 0x00 0x32
             0x00 0xf9]
        ;; expected = the four f32 values 1.0, 3.5, -2.25, 100.0
        exp [0x00 0x00 0x80 0x3f 0x00 0x00 0x60 0x40 0x00 0x00 0x10 0xc0 0x00 0x00
             0xc8 0x42]
        out (mo/decode-filter-exp buf 4 4)]
    (is (= out exp))))

#?(:clj
   (deftest exp-filter-decodes-one
     ;; m=1, e=0 -> ldexp(1,0)=1.0
     (let [buf [1 0 0 0]
           out (mo/decode-filter-exp buf 1 4)
           f (Float/intBitsToFloat (unchecked-int (bit-or (nth out 0) (bit-shift-left (nth out 1) 8)
                                                            (bit-shift-left (nth out 2) 16) (bit-shift-left (nth out 3) 24))))]
       (is (< (Math/abs (- f 1.0)) 1e-6)))))
