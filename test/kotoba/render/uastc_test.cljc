(deftest uastc-blocks-match-reference-decoder
  (doseq [[block expected] uastc-vectors]
    (is (= (uastc/decode-block-rgba block) expected)
        (str "block " block))))

(deftest uastc-vector-coverage
  ;; guard against silently shipping fewer vectors than the Rust source had
  (is (= 120 (count uastc-vectors)))
  ;; every block decodes without throwing and yields 64 bytes in 0..255
  (doseq [[block _] uastc-vectors]
    (let [px (uastc/decode-block-rgba block)]
      (is (= 64 (count px)))
      (is (every? #(<= 0 % 255) px)))))

(deftest ktx2-identifier-detect
  (is (basisu/is-ktx2? basisu/ktx2-identifier))
  (is (not (basisu/is-ktx2? (mapv int "not a ktx2 file")))))

(defn- u32-bytes [v]
  [(bit-and v 0xff) (bit-and (bit-shift-right v 8) 0xff)
   (bit-and (bit-shift-right v 16) 0xff) (bit-and (bit-shift-right v 24) 0xff)])
;; `(bit-shift-right v 32)` is v on ClojureScript: JS shift counts are taken
;; mod 32, so `104 >> 32` is 104, not 0. This helper therefore wrote the LOW
;; dword into the HIGH dword of every u64 field, and `decode-ktx2` read a
;; level offset of 104 + 104*2^32 and threw `:truncated`. `quot`/`mod` are
;; arithmetic on both runtimes, and are what `basisu/u64-le` already uses to
;; go the other way (`* 0x100000000`). Measured 2026-08-24.
(defn- u64-bytes [v]
  (into (u32-bytes (mod v 0x100000000)) (u32-bytes (quot v 0x100000000))))

(deftest ktx2-container-roundtrip
  ;; Build a minimal 8x8 UASTC KTX2 (2x2 blocks, supercompression none) from
  ;; four reference blocks and verify decode-ktx2 reconstructs the image —
  ;; exercising container parsing + block iteration + RGBA assembly (ported
  ;; from basisu.rs's ktx2_container_roundtrip).
  (let [blocks (mapv first (take 4 uastc-vectors))
        level (vec (mapcat identity blocks))
        level-offset 104
        header (vec (concat
                     basisu/ktx2-identifier
                     (u32-bytes 0) (u32-bytes 1) (u32-bytes 8) (u32-bytes 8)
                     (u32-bytes 0) (u32-bytes 0) (u32-bytes 1) (u32-bytes 1)
                     (u32-bytes 0)
                     ;; index: dfd off/len, kvd off/len (u32), sgd off/len (u64)
                     (u32-bytes 0) (u32-bytes 0) (u32-bytes 0) (u32-bytes 0)
                     (u64-bytes 0) (u64-bytes 0)
                     ;; level index (1 level): byteOffset, byteLength, uncompLen
                     (u64-bytes level-offset) (u64-bytes (count level)) (u64-bytes (count level))))
        _ (is (= level-offset (count header)))
        ktx (into header level)
        img (basisu/decode-ktx2 ktx)]
    (is (= [8 8] [(:width img) (:height img)]))
    (is (= (* 8 8 4) (count (:rgba img))))
    ;; each block's pixels landed in the right 4x4 region
    (doseq [bi (range 4)]
      (let [b (nth blocks bi)
            bx (mod bi 2) by (quot bi 2)
            px (uastc/decode-block b)]
        (doseq [ty (range 4) tx (range 4)]
          (let [x (+ (* bx 4) tx) y (+ (* by 4) ty)
                di (* (+ (* y 8) x) 4)]
            (is (= (subvec (:rgba img) di (+ di 4)) (nth px (+ (* ty 4) tx)))
                (str "block " bi " texel (" tx "," ty ")"))))))))

(deftest ktx2-etc1s-reported-unsupported
  (let [k (vec (concat basisu/ktx2-identifier (repeat (- 80 12) 0)))
        put (fn [v off bytes] (reduce (fn [a [i b]] (assoc a (+ off i) b))
                                      v (map-indexed vector bytes)))
        k (-> k
              (put 20 (u32-bytes 4))  ; width
              (put 24 (u32-bytes 4))  ; height
              (put 40 (u32-bytes 1))  ; levelCount
              (put 44 (u32-bytes 1)))] ; BasisLZ -> ETC1S
    (is (= :etc1s-unsupported
           (try (basisu/decode-ktx2 k) nil
                (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) e
                  (:type (ex-data e))))))))
